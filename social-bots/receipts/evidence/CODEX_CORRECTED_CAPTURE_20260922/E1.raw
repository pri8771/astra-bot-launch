<script type="text/javascript">
jQuery(document).ready(function($) {
  var $sidebar = $('.sidebar-container');
  var $article = $('.featured-container'); // need to see if featured exists, if not then use $('.entry-content');
  var navHeight = 170; // Height of the navigation menu

  // Cache the initial top offset of the sidebar
  var sidebarTop = $sidebar.offset().top;

  // Calculate the bottom position of the article content
  var articleBottom = $article.offset().top + $article.outerHeight();

  $(window).scroll(function() {
    var scrollTop = $(window).scrollTop();
    var sidebarHeight = $sidebar.outerHeight();

    // Check if the header is fixed by checking the presence of the 'uk-sticky-fixed' class
    var isHeaderFixed = $('#masthead').hasClass('uk-sticky-fixed');
    var topOffset = isHeaderFixed ? navHeight+10 : 10;

    // Adjust the sidebar's position based on the scroll position
    if (scrollTop > sidebarTop - topOffset) {
      $sidebar.css({
        'position': 'sticky',
        'top': topOffset + 'px',
		'margin-bottom': '191px'
        });
    } else {
      $sidebar.css({
        'position': 'relative',
        'top': '0',
      });
    }
  });
});

var h, w, needresize;

jQuery(document).ready(checkContainer);

function checkContainer () {
	if(jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop').height() < 300) {
		window.requestAnimationFrame(checkContainer);
	} else {
	createResize();
	}
}

function createResize() {
jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop span iframe').each(function(i, obj) {
	var checkExist = setInterval(function() {
		h = jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop span iframe')[i].style.height;
		w = jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop span iframe')[i].style.width;
		h = h.replace("px", "");
		w = w.replace("px", "");
		w = parseInt(w);
		h = parseInt(h);

			if (h > 0) {
			if (h > 478) {
				needresize = true;
				jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop')[i].style.margin= 'auto';
				jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop')[i].style.width = '420px';
				var cnfrm = jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop')[i].style.margin;
				jQuery('div.fb-video.fb_iframe_widget.fb_iframe_widget_fluid_desktop').eq(i).addClass("verticalvid");
				} else {
				needresize = false;
				}
			clearInterval(checkExist);
			} else {

			}
	}, 100);
});
}

// Adjust Jetpack Slideshow Controls Position
jQuery(document).ready(function() {
	console.log('Checking for .single .jetpack-slideshow-slide element...');
	
	var slideshowSlide = jQuery('.single .jetpack-slideshow-slide');
	
	if (slideshowSlide.length > 0) {
		console.log('✓ .single .jetpack-slideshow-slide exists on the page');
		console.log('Number of slideshow slides found:', slideshowSlide.length);
		
		function adjustSlideshowControls() {
			var slideHeight = slideshowSlide.outerHeight();
			var windowWidth = jQuery(window).width();
			console.log('Slideshow slide height:', slideHeight + 'px');
			console.log('Window width:', windowWidth + 'px');
			
			if (slideHeight > 0) {
				// Set top position based on window width
				// Window width > 1024px → 290px
				// Window width 768-1024px → 280px
				// Window width 430-640px → 150px
				// Window width 390-420px → 140px
				// Window width < 390px → 140px
				var topPosition;
				var breakpointLabel;
				
				if (windowWidth > 1024) {
					topPosition = 290;
					breakpointLabel = '> 1024px (desktop)';
				} else if (windowWidth >= 768 && windowWidth <= 1024) {
					topPosition = 280;
					breakpointLabel = '768-1024px (tablet)';
				} else if (windowWidth >= 430 && windowWidth <= 640) {
					topPosition = 150;
					breakpointLabel = '430-640px (large mobile)';
				} else if (windowWidth >= 390 && windowWidth <= 420) {
					topPosition = 140;
					breakpointLabel = '390-420px (mobile)';
				} else {
					topPosition = 140;
					breakpointLabel = '< 390px (small mobile)';
				}
				
				var newTopValue = topPosition + 'px';
				
				console.log('Calculated top position:', newTopValue, '(based on window width ' + breakpointLabel + ')');
				
				// Update CSS for all button-stop elements (paused and running)
				var stopButtons = jQuery('body div div.jetpack-slideshow-controls a.button-stop');
				console.log('Found stop buttons:', stopButtons.length);
				
				if (stopButtons.length > 0) {
					stopButtons.css('top', newTopValue);
					console.log('✓ CSS updated for .button-stop elements');
					console.log('Applied top value to controls:', stopButtons.css('top'));
				} else {
					console.log('⚠ Stop buttons not found yet, will retry in 300ms...');
					setTimeout(adjustSlideshowControls, 300);
				}
			} else {
				console.log('⚠ Slide height is 0, waiting for content to load...');
				// Retry after a short delay if height is 0
				setTimeout(adjustSlideshowControls, 500);
			}
		}
		
		// Initial adjustment
		adjustSlideshowControls();
		
		// Re-adjust on window resize
		jQuery(window).on('resize', function() {
			console.log('Window resized, re-adjusting slideshow controls...');
			adjustSlideshowControls();
		});
		
	} else {
		console.log('✗ .single .jetpack-slideshow-slide does NOT exist on this page');
	}
});
</script>
<script>
(function () {
	document.addEventListener('DOMContentLoaded', function () {
		var slideshows = document.querySelectorAll('.jetpack-slideshow');
		if (!slideshows.length) {
			return;
		}

		var ICON_SETS = {
			dark: {
				prev: '/wp-content/themes/fbcorp/assets/images/chevron-left.svg',
				next: '/wp-content/themes/fbcorp/assets/images/chevron-right.svg',
				play: '/wp-content/themes/fbcorp/assets/images/carousel_arrow_play.png',
				pause: '/wp-content/themes/fbcorp/assets/images/carousel_arrow_pause.png',
			},
			light: {
				prev: '/wp-content/themes/fbcorp/assets/images/chevron-left-wht.svg',
				next: '/wp-content/themes/fbcorp/assets/images/chevron-right-wht.svg',
				play: '/wp-content/themes/fbcorp/assets/images/carousel_arrow_play-wht.png',
				pause: '/wp-content/themes/fbcorp/assets/images/carousel_arrow_pause-wht.png',
			},
		};

		var luminanceCache = typeof WeakMap !== 'undefined' ? new WeakMap() : null;
		var captionMarginTimer = null;

		function captionLineHeight(caption) {
			var styles = window.getComputedStyle(caption);
			var lineHeight = parseFloat(styles.lineHeight);
			if (!lineHeight) {
				lineHeight = parseFloat(styles.fontSize) * 1.5;
			}
			return lineHeight || 24;
		}

		function measureCaptionHeight(caption, slideshow) {
			if (!caption.textContent.trim() && !caption.children.length) {
				return 0;
			}

			var width =
				caption.getBoundingClientRect().width ||
				slideshow.getBoundingClientRect().width ||
				slideshow.clientWidth;
			if (!width) {
				return 0;
			}

			var clone = caption.cloneNode(true);
			clone.style.cssText += [
				';display:block!important',
				';visibility:hidden!important',
				';position:absolute!important',
				';left:-9999px!important',
				';top:0!important',
				';bottom:auto!important',
				';width:' + width + 'px!important',
				';height:auto!important',
				';max-height:none!important',
				';white-space:normal!important',
				';overflow:visible!important',
			].join('');

			document.body.appendChild(clone);
			var height = Math.max(clone.scrollHeight, clone.getBoundingClientRect().height);
			document.body.removeChild(clone);

			return height;
		}

		function adjustCaptionMargin(slideshow) {
			var captions = slideshow.querySelectorAll('.jetpack-slideshow-slide-caption, .slideshow-slide-caption');
			if (!captions.length) {
				return;
			}

			var tallestCaption = 0;
			var lineHeight = 0;

			captions.forEach(function (caption) {
				tallestCaption = Math.max(tallestCaption, measureCaptionHeight(caption, slideshow));
				lineHeight = Math.max(lineHeight, captionLineHeight(caption));
			});

			if (tallestCaption) {
				slideshow.style.setProperty('margin-bottom', Math.ceil(tallestCaption + lineHeight) + 'px', 'important');
			}
		}

		function queueCaptionMarginUpdate() {
			window.clearTimeout(captionMarginTimer);
			captionMarginTimer = window.setTimeout(function () {
				document.querySelectorAll('.jetpack-slideshow').forEach(function (slideshow) {
					adjustCaptionMargin(slideshow);
				});
			}, 80);
		}

		function analyzeImage(img, callback) {
			if (!img || typeof callback !== 'function') {
				return;
			}
			if (luminanceCache && luminanceCache.has(img)) {
				callback(luminanceCache.get(img));
				return;
			}

			function compute() {
				var width = img.naturalWidth || img.width;
				var height = img.naturalHeight || img.height;
				if (!width || !height) {
					callback(null);
					return;
				}
				var sampleSize = 24;
				var sw = Math.min(sampleSize, width);
				var sh = Math.min(sampleSize, height);
				var canvas = document.createElement('canvas');
				var ctx = canvas.getContext && canvas.getContext('2d');
				if (!ctx) {
					callback(null);
					return;
				}
				canvas.width = sw;
				canvas.height = sh;
				var positions = [
					{ x: Math.max(0, width - sw), y: 0 },
					{ x: Math.max(0, width - sw), y: Math.max(0, Math.round(height / 2 - sh / 2)) },
					{ x: Math.max(0, width - sw), y: Math.max(0, height - sh) },
				];
				try {
					var samples = [];
					for (var i = 0; i < positions.length; i++) {
						var pos = positions[i];
						ctx.clearRect(0, 0, sw, sh);
						ctx.drawImage(img, pos.x, pos.y, sw, sh, 0, 0, sw, sh);
						var data = ctx.getImageData(0, 0, sw, sh).data;
						var total = 0;
						var pixels = data.length / 4;
						for (var j = 0; j < data.length; j += 4) {
							var r = data[j];
							var g = data[j + 1];
							var b = data[j + 2];
							total += 0.2126 * r + 0.7152 * g + 0.0722 * b;
						}
						samples.push(total / pixels);
					}
					var darkThreshold = 125;
					var darkCount = samples.filter(function (val) {
						return val <= darkThreshold;
					}).length;
					var theme = darkCount >= 2 ? 'light' : 'dark';
					if (luminanceCache) {
						luminanceCache.set(img, theme);
					}
					callback(theme);
				} catch (err) {
					callback(null);
				}
			}

			if (!img.complete || !img.naturalWidth) {
				img.addEventListener('load', function onLoad() {
					img.removeEventListener('load', onLoad);
					compute();
				});
				return;
			}

			compute();
		}

		function getVisibleSlideImage(slideshow) {
			if (!slideshow) {
				return null;
			}
			var selectors = ['.jetpack-slideshow-slide img', '.jetpack-slideshow-window img', 'img'];
			var imgs = null;
			for (var i = 0; i < selectors.length; i++) {
				var found = slideshow.querySelectorAll(selectors[i]);
				if (found && found.length) {
					imgs = found;
					break;
				}
			}
			if (!imgs || !imgs.length) {
				return null;
			}
			var fallback = imgs[0];
			for (var j = 0; j < imgs.length; j++) {
				var img = imgs[j];
				var holder = img.closest('.jetpack-slideshow-slide') || img;
				var style = window.getComputedStyle(holder);
				if (!style) {
					continue;
				}
				if (style.display === 'none' || style.visibility === 'hidden') {
					continue;
				}
				var opacity = parseFloat(style.opacity || '1');
				if (opacity < 0.1) {
					continue;
				}
				return img;
			}
			return fallback;
		}

		function applyControlTheme(slideshow, theme) {
			var controls = slideshow.querySelector('.jetpack-slideshow-controls');
			if (!controls) {
				return;
			}
			var palette = ICON_SETS[theme === 'light' ? 'light' : 'dark'];
			var prev = controls.querySelector('.button-prev');
			var next = controls.querySelector('.button-next');
			var stop = controls.querySelector('.button-stop');

			function setControlBackground(el, url) {
				if (!el || !url) {
					return;
				}
				el.style.setProperty('background-image', 'url(' + url + ')', 'important');
			}

			setControlBackground(prev, palette.prev);
			setControlBackground(next, palette.next);
			if (stop) {
				var isPaused = stop.classList.contains('paused') && !stop.classList.contains('running');
				setControlBackground(stop, isPaused ? palette.play : palette.pause);
			}
		}

		function updateControls(slideshow) {
			var img = getVisibleSlideImage(slideshow);
			if (!img) {
				return;
			}
			analyzeImage(img, function (theme) {
				applyControlTheme(slideshow, theme || 'dark');
			});
		}

		function watchSlideshow(slideshow) {
			if (slideshow.dataset.pmzControlWatcher === '1') {
				return;
			}
			var slides = slideshow.querySelectorAll('.jetpack-slideshow-slide');
			if (!slides.length) {
				setTimeout(function () {
					watchSlideshow(slideshow);
				}, 300);
				return;
			}
			slideshow.dataset.pmzControlWatcher = '1';

			var scheduled = null;
			function queueUpdate() {
				if (scheduled) {
					return;
				}
				scheduled = setTimeout(function () {
					scheduled = null;
					updateControls(slideshow);
				}, 80);
			}

			updateControls(slideshow);
			adjustCaptionMargin(slideshow);

			if (typeof MutationObserver !== 'undefined') {
				var observer = new MutationObserver(function (mutations) {
					for (var i = 0; i < mutations.length; i++) {
						var target = mutations[i].target;
						if (
							target &&
							target.classList &&
							(target.classList.contains('jetpack-slideshow-slide') ||
								target.classList.contains('jetpack-slideshow-window'))
						) {
							queueUpdate();
							break;
						}
					}
				});
				slides.forEach(function (slide) {
					observer.observe(slide, { attributes: true, attributeFilter: ['style', 'class'] });
				});
				slideshow._pmzControlsObserver = observer;
			}

			if (typeof MutationObserver !== 'undefined') {
				var containerObserver = new MutationObserver(function (mutations) {
					for (var i = 0; i < mutations.length; i++) {
						var mutation = mutations[i];
						if (mutation.type === 'childList') {
							for (var j = 0; j < mutation.addedNodes.length; j++) {
								var node = mutation.addedNodes[j];
								if (
									node.nodeType === 1 &&
									node.classList &&
									node.classList.contains('jetpack-slideshow-controls')
								) {
									queueUpdate();
									return;
								}
							}
						}
					}
				});
				containerObserver.observe(slideshow, { childList: true, subtree: false });
			}

			var controls = slideshow.querySelectorAll('.jetpack-slideshow-controls a');
			controls.forEach(function (ctrl) {
				ctrl.addEventListener('click', queueUpdate);
			});

			var stop = slideshow.querySelector('.jetpack-slideshow-controls .button-stop');
			if (stop && typeof MutationObserver !== 'undefined') {
				var stopObserver = new MutationObserver(function () {
					queueUpdate();
				});
				stopObserver.observe(stop, { attributes: true, attributeFilter: ['class'] });
			}
		}

		function initSlideshows() {
			var instances = document.querySelectorAll('.jetpack-slideshow');
			instances.forEach(function (slideshow) {
				watchSlideshow(slideshow);
				adjustCaptionMargin(slideshow);
			});
		}

		initSlideshows();
		setTimeout(initSlideshows, 800);
		window.addEventListener('load', queueCaptionMarginUpdate);
		window.addEventListener('resize', queueCaptionMarginUpdate);
		if (document.fonts && document.fonts.ready) {
			document.fonts.ready.then(queueCaptionMarginUpdate);
		}

		if (window.jQuery) {
			window.jQuery(document).on('jetpack-slideshow-initialized', function () {
				setTimeout(initSlideshows, 120);
			});
		}
	});
})();
</script>
