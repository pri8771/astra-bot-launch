				rect &&
				point.x >= rect.left &&
				point.x <= rect.right &&
				point.y >= rect.top &&
				point.y <= rect.bottom
			);
		}

		function mediaLuminanceAtPoint(media, point) {
			var rect = media ? media.getBoundingClientRect() : null;
			var width;
			var height;
