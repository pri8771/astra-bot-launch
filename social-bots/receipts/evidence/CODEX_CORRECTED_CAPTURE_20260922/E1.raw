            <span class="search-glass-icon"><svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M2.545 2.546c3.349-3.35 8.746-3.4 12.031-.115 3.048 3.048 3.223 7.914.558 11.275.438.434 3.148 3.144 4.22 4.216l.41.41c.356.355.29.998-.072 1.36-.363.363-1.005.428-1.36.072-2.74-2.739-4.283-4.28-4.633-4.625-3.36 2.66-8.222 2.483-11.268-.563-3.286-3.285-3.234-8.682.114-12.03zm10.717 1.428a6.575 6.575 0 00-9.288 0 6.575 6.575 0 000 9.288 6.575 6.575 0 009.288 0 6.575 6.575 0 000-9.288z" fill="currentColor" fill-rule="evenodd"/></svg></span>            <label class="search-label" for="header_search_input_sub">Search News</label>            <div id="js-header_search_input_sub_container" class="header-search-input-container"></div>            <button id="header_search_reset_sub" class="header-search-reset sub" type="reset">Clear</button>
        </form>
