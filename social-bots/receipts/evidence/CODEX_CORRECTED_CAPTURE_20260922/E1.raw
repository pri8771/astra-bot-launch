			<style type="text/css" id="wp-custom-css">
			body.product-launch-post .product-launch-post__article .product-launch-video-caption {
	padding-bottom: 0px !important;
}

body.product-launch-post .jetpack-video-wrapper {
    margin-bottom: 0px !important;
}

@media (max-width: 639px) {
.archive.category .loop-section.archive-posts-section .posts-and-pagination, .archive.tag .loop-section.archive-posts-section .posts-and-pagination {
margin-left: -20px !important;
}
}

@media (min-width: 640px) and (max-width: 991px) {
.archive.category .loop-section.archive-posts-section .posts-and-pagination, .archive.tag .loop-section.archive-posts-section .posts-and-pagination {
padding-left: 30px !important;
}
}

.single b, .single strong {
	font-family: 'Optimistic Text', Helvetica, Arial, 'NotoSans', 'NotoSansJP', 'NotoSansKR', sans-serif;
}

.product-grid {
	display: flex;
	justify-content: center;
	align-items: stretch;
	gap: 20px;
	width: 100%;
	padding: 20px;
	box-sizing: border-box;
}

.product-column {
	flex: 1;
	max-width: 33.33%;
	text-align: center;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.product-column img {
	max-width: 100%;
	height: auto;
	margin-bottom: 10px;
}

.product-column h3 {
	margin: 10px 0 5px;
	font-size: 16px;
}

.product-link {
	color: #0073e6;
	text-decoration: none;
	font-weight: 500;
}

.product-link:hover {
	text-decoration: underline;
}

.twocolumn-mm.shop {
	padding-right: 5%;
}

.twocolumn-mm.shop .footer-column-two:nth-child(5) {
    width: 100%;
    max-width: 100% !important;
}

.twocolumn-mm.shop > .footer-column-two:last-of-type {
	display: none !important;
}

@media (min-width: 960px) {
    .archive .archive-articles-2col-container {
        margin-left: 40px !important;
    }
	.archive .archive-posts-container .uk-grid.archive-posts-grid {
    	padding-left: 0px;
    	padding-right: 0px;
	}
	.archive .maxw13 {
		max-width: 1266px !important;
	}
}

@media screen and (max-width: 959px) {
    .search-query-container>.uk-grid, .search-posts-container>.uk-grid, .highlights-container>.uk-grid, .lowlight-container>.uk-grid, .archive-header-container>.uk-grid, .archive-posts-container>.uk-grid {
        padding-left: 40px;
        padding-right: 40px;
    }
}

@media screen and (max-width: 639px) {
    .archive .loop-section.archive-posts-section .posts-and-pagination {
    	margin-left: -40px;
	}
}

.query-and-results .uk-search-navbar .uk-search-input {
    padding-left: 54px !important;
}

.mejs-poster.mejs-layer {
    border-radius: 24px;
}

@media screen and (max-width: 768px) {
    .blog .highlights-column-a, .blog .highlights-column-b {
        padding-right: 0px;
        padding-left: 0px;
    }
}

@media screen and (min-width: 1160px) {
	.twocolumn-mm.our_technologies .footer-column-two .footer-col-title {
    display: none;
}
}

/* Nav Updates */

/* 9/15 patch */
.twocolumn-mm img {
    max-height: 150px;
    width: auto;
    margin: 0px !important;
}

.twocolumn-mm.support {
    justify-content: end;
    float: right;
    padding-left: 30%;
    padding-right: 0%;
}

.twocolumn-mm.support > .footer-column-two {
    order: 1;
}
  
.twocolumn-mm.support > .footer-column-two:nth-child(3) { order: 3; }
.twocolumn-mm.support > .footer-column-two:nth-child(4) { order: 4; }
.twocolumn-mm.support > .footer-column-two:nth-child(5) { order: 5; }

.twocolumn-mm img {
    max-height: 150px;
    width: auto;
}

.twocolumn-mm .widget_media_image {
    text-align: center;
}

.twocolumn-mm .textwidget a {
    font-size: 14px !important;
    font-weight: 600;
}

.twocolumn-mm .textwidget p {
    text-align: center;
}

.twocolumn-mm.shop .footer-column-two:nth-child(2n+2) {
	display: block;
}

@media (max-width: 991px) {
	.twocolumn-mm.shop li.js-accordion-item:nth-child(2n+2) {
		display: block;
	}
	.twocolumn-mm.shop li.js-accordion-item:nth-child(1n+3) {
		display: none;
	}
}

.twocolumn-mm.shop .footer-column-two {
    max-width: 247.8px !important;
}

.main-navigation li.menu-item > a.menu-link:hover,
