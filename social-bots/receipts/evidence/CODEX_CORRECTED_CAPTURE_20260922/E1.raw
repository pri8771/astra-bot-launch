				var about_us_overlay = jQuery('<div class="twocolumn-mm about_us uk-visible@m animated animated2" style="display:none;"><div class="mobilemenu_header_title uk-hidden@m"><h2 class="ui-heading1"></h2></div></div>').append(jQuery('.twocolumn-mm.about_us').html());
