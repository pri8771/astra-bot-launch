	<script>
	(function() {
		function hideVideoControls(video) {
			var container;
			var controls;
			var wrapper;

			wrapper = video.closest('.wp-video');
			if (wrapper) {
				wrapper.classList.add('fbcorp-autoplay-loop-video-wrap');
			}

			container = video.closest('.mejs-container');
			if (!container) {
				return;
			}

			container.classList.add('fbcorp-autoplay-loop-video-container');
			controls = container.querySelectorAll('.mejs-controls, .mejs-overlay-play, .mejs-overlay-loading, .mejs-overlay-button');
			controls.forEach(function(control) {
				control.style.display = 'none';
				control.setAttribute('aria-hidden', 'true');
			});
		}

		function prepareVideo(video) {
			if (!video) {
				return;
			}

			video.muted = true;
			video.defaultMuted = true;
			video.loop = true;
			video.autoplay = true;
			video.controls = false;
			video.setAttribute('autoplay', '');
			video.setAttribute('loop', '');
			video.setAttribute('muted', '');
			video.setAttribute('playsinline', '');
			video.setAttribute('webkit-playsinline', '');
			video.removeAttribute('controls');
			hideVideoControls(video);
		}

		function playVideo(video) {
			var playPromise;

			if (!video) {
				return;
			}

			if (typeof video.play === 'function' && video.paused) {
				playPromise = video.play();

				if (playPromise && typeof playPromise.catch === 'function') {
					playPromise.catch(function(error) {
						if (error && error.name === 'AbortError') {
							window.setTimeout(function() {
								playVideo(video);
							}, 250);
						}
					});
				}
			}
		}

		function scheduleVideo(video, delay) {
			prepareVideo(video);
			window.clearTimeout(video.fbcorpAutoplayTimer);
			video.fbcorpAutoplayTimer = window.setTimeout(function() {
				playVideo(video);
			}, delay);
		}

		function initAutoplayVideos() {
			var videos = document.querySelectorAll('video.fbcorp-featured-loop-video, video.fbcorp-autoplay-loop-video, video[data-fbcorp-autoplay-loop="true"]');

			videos.forEach(function(video, index) {
				var delay = video.classList.contains('fbcorp-featured-loop-video') ? 0 : 500 + (index * 200);

				if (video.readyState < 2) {
					video.addEventListener('canplay', function() {
						scheduleVideo(video, delay);
					}, { once: true });
				}

				scheduleVideo(video, delay);
			});
		}

		function replayPausedAutoplayVideos() {
			document.querySelectorAll('video.fbcorp-autoplay-loop-video, video[data-fbcorp-autoplay-loop="true"]').forEach(function(video, index) {
				if (video.paused) {
					scheduleVideo(video, index * 150);
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initAutoplayVideos);
		} else {
			initAutoplayVideos();
		}

		window.addEventListener('load', initAutoplayVideos);
		setTimeout(initAutoplayVideos, 600);
		setTimeout(initAutoplayVideos, 1500);
		setTimeout(replayPausedAutoplayVideos, 1500);
		setTimeout(replayPausedAutoplayVideos, 3000);
		setTimeout(replayPausedAutoplayVideos, 5000);
	})();
	</script>
		<script>
	(function() {
		var TRANSITION_MS = 1000;
		var SWITCH_DELAY = 420;
		var TRANSITION_FADE_MS = 520;
		var MIN_REVEAL_DELAY = SWITCH_DELAY + TRANSITION_FADE_MS + 160;
		var AUTO_ADVANCE_LEAD_MS = SWITCH_DELAY + 180;
		var delegatedControlsBound = false;

		function toArray(list) {
			return Array.prototype.slice.call(list || []);
		}

		function playlistData(playlist) {
			var dataNode = playlist ? playlist.querySelector('script.wp-playlist-script') : null;

			if (!dataNode) {
				return {};
			}

			try {
				return JSON.parse(dataNode.textContent || dataNode.innerHTML || '{}');
			} catch (error) {
				return {};
			}
		}

		function getPlaylistTrackCount(playlist) {
			var data = playlistData(playlist);

			return data && Array.isArray(data.tracks) ? data.tracks.length : 0;
		}

		function playlistTrackIds(playlist) {
			return String(playlist ? playlist.getAttribute('data-fbcorp-video-playlist-attachment-ids') || '' : '')
				.split(',')
				.map(function(id) {
					return parseInt(id, 10);
				})
				.filter(function(id) {
					return id > 0;
				});
		}

		function normalizeUrl(url) {
			var anchor;

			if (!url) {
				return '';
			}

			anchor = document.createElement('a');
			anchor.href = url;

			return anchor.href;
		}

		function currentTrackIndex(playlist) {
			var data = playlistData(playlist);
			var tracks = data && Array.isArray(data.tracks) ? data.tracks : [];
			var video = playlist ? playlist.querySelector('video') : null;
			var currentSrc = normalizeUrl(video ? video.currentSrc || video.src || video.getAttribute('src') : '');
			var playing = playlist ? playlist.querySelector('.wp-playlist-playing') : null;
			var index = -1;

			if (currentSrc) {
				tracks.some(function(track, trackIndex) {
					if (normalizeUrl(track.src) === currentSrc) {
						index = trackIndex;
						return true;
					}

					return false;
				});
			}

			if (index < 0 && playing) {
				index = toArray(playlist.querySelectorAll('.wp-playlist-item')).indexOf(playing);
			}

			return index >= 0 ? index : 0;
		}

		function activeAttachmentId(playlist) {
			var ids = playlistTrackIds(playlist);
			var index = currentTrackIndex(playlist);

			return ids[index] || ids[0] || 0;
		}

		function clamp(value, min, max) {
			return Math.min(Math.max(value, min), max);
		}

		function rgbaLuminance(color) {
			var match = String(color || '').match(/rgba?\(([^)]+)\)/);
			var parts;
			var alpha;
			var r;
			var g;
			var b;

			if (!match) {
				return null;
			}

			parts = match[1].split(',').map(function(part) {
				return part.trim();
			});
			alpha = parts.length > 3 ? parseFloat(parts[3]) : 1;

			if (alpha <= 0.05) {
				return null;
			}

			r = parseFloat(parts[0]);
			g = parseFloat(parts[1]);
			b = parseFloat(parts[2]);

			if (!isFinite(r) || !isFinite(g) || !isFinite(b)) {
				return null;
			}

			return (0.2126 * r) + (0.7152 * g) + (0.0722 * b);
		}

		function elementBackgroundLuminance(element) {
			var node = element;
			var luminance;

			while (node && node.nodeType === 1) {
				luminance = rgbaLuminance(window.getComputedStyle(node).backgroundColor);
				if (luminance !== null) {
					return luminance;
				}
				node = node.parentElement;
			}

			return 255;
		}

		function centerPoint(element) {
			var rect = element ? element.getBoundingClientRect() : null;

			if (!rect) {
