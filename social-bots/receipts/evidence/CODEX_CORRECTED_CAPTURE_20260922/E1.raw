			context = canvas.getContext && canvas.getContext('2d');

			if (!context) {
				return null;
			}

			canvas.width = 1;
			canvas.height = 1;
			sampleSize = Math.max(12, Math.min(72, Math.round(Math.min(width, height) * 0.08)));
			sx = clamp(((point.x - rect.left) / rect.width * width) - (sampleSize / 2), 0, Math.max(0, width - sampleSize));
			sy = clamp(((point.y - rect.top) / rect.height * height) - (sampleSize / 2), 0, Math.max(0, height - sampleSize));

			try {
				context.drawImage(media, sx, sy, sampleSize, sampleSize, 0, 0, 1, 1);
				data = context.getImageData(0, 0, 1, 1).data;
			} catch (error) {
				return null;
			}

			return (0.2126 * data[0]) + (0.7152 * data[1]) + (0.0722 * data[2]);
		}

		function controlThemeAtPoint(playlist, point) {
			var video = playlist ? playlist.querySelector('video') : null;
			var luminance = mediaLuminanceAtPoint(video, point);
			var elementAtPoint;

			if (luminance === null && point) {
				elementAtPoint = document.elementFromPoint(point.x, point.y);
				luminance = elementBackgroundLuminance(elementAtPoint || playlist);
			}

			return luminance !== null && luminance <= 125 ? 'light' : 'dark';
		}

		function setDownloadIcon(download, theme) {
			var icon = download ? download.querySelector('img') : null;
			var nextSrc;

			if (!download || !icon) {
				return;
			}

			nextSrc = theme === 'light' ?
				(download.getAttribute('data-fbcorp-video-playlist-icon-light') || '') :
				(download.getAttribute('data-fbcorp-video-playlist-icon') || '');

			if (!nextSrc || icon.src === nextSrc) {
